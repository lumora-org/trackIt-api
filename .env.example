# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trackit
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
# Optional: when set, takes precedence over the discrete DATABASE_* values above
DATABASE_URL=

# ─── JWT ────────────────────────────────────────────────────────────────────
# MUST be replaced with long random secrets. Never commit real values.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=30m

# ─── Refresh token cookie ──────────────────────────────────────────────────── 
# Name must stay kby_refresh_token — the frontend reads it.
REFRESH_COOKIE_NAME=kby_refresh_token
REFRESH_COOKIE_SECURE=false
# lax (default) suits same-site deployments: the Next.js proxy keeps the
# browser and API same-origin regardless of hosts. Use 'none' only when the
# frontend and API are hosted on DIFFERENT sites (cross-site XHR needs it);
# browsers then also require REFRESH_COOKIE_SECURE=true (HTTPS).
REFRESH_COOKIE_SAMESITE=lax

# ─── HTTP ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# ─── Business timezone (daily report day boundaries, Africa/Lagos = UTC+1) ───
BUSINESS_TIMEZONE=Africa/Lagos

# ─── Inventory ──────────────────────────────────────────────────────────────
# Litres at or below this level raise a LOW_INVENTORY notification.
LOW_INVENTORY_THRESHOLD_LITRES=500

# ─── Web Push (PWA alerts) ───────────────────────────────────────────────────
# Generate a key pair once per environment with:
#   npx web-push generate-vapid-keys --json
# Leave BOTH empty to keep push switched off: the endpoints then answer
# `enabled: false`, nothing is stored or sent, and every other feature is
# unaffected. Setting only one of the two is a startup error.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID requires a contact URL so push services can report problems.
VAPID_SUBJECT=mailto:alerts@kbyglobal.example
# Devices remembered per user before the oldest are pruned.
PUSH_MAX_SUBSCRIPTIONS_PER_USER=10
# Seconds a message may stay queued at the push service before being dropped.
PUSH_TTL_SECONDS=3600